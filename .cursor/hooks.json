{
    "version": 1,
    "hooks": {
        "afterAgentResponse": [
            {
                "command": "uv run .cursor/hooks/log_usage.py"
            }
        ],
        "afterAgentThought": [
            {
                "command": "uv run .cursor/hooks/log_usage.py"
            }
        ],
        "afterFileEdit": [
            {
                "command": "uv run .cursor/hooks/log_usage.py"
            }
        ],
        "afterMCPExecution": [
            {
                "command": "uv run .cursor/hooks/log_usage.py"
            }
        ],
        "afterShellExecution": [
            {
                "command": "uv run .cursor/hooks/log_usage.py"
            }
        ],
        "afterTabFileEdit": [
            {
                "command": "uv run .cursor/hooks/log_usage.py"
            }
        ],
        "beforeMCPExecution": [
            {
                "command": "uv run .cursor/hooks/log_usage.py"
            }
        ],
        "beforeReadFile": [
            {
                "command": "uv run .cursor/hooks/log_usage.py"
            }
        ],
        "beforeShellExecution": [
            {
                "command": "uv run .cursor/hooks/log_usage.py"
            }
        ],
        "beforeSubmitPrompt": [
            {
                "command": "uv run .cursor/hooks/log_usage.py"
            }
        ],
        "beforeTabFileRead": [
            {
                "command": "uv run .cursor/hooks/log_usage.py"
            }
        ],
        "stop": [
            {
                "command": "uv run .cursor/hooks/log_usage.py"
            }
        ]
    }
}
